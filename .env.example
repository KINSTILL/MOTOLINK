# Base de données PostgreSQL (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/motolink?schema=public"

# NextAuth.js
NEXTAUTH_SECRET="your-super-secret-nextauth-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# NotchPay (Paiements Cameroun / FCFA : Orange Money, MTN MoMo)
NOTCHPAY_PUBLIC_KEY="pk.live.xxxxxxxxxxxxxxxxxxxxxxxx"
NOTCHPAY_SECRET_KEY="sk.live.xxxxxxxxxxxxxxxxxxxxxxxx"
NOTCHPAY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"

# Firebase Cloud Messaging (Notifications Push PWA)
FCM_SERVER_KEY="your-firebase-cloud-messaging-server-key"

# Cloudflare R2 (Stockage photos & signatures sécurisées)
R2_ACCESS_KEY="your-cloudflare-r2-access-key"
R2_SECRET_KEY="your-cloudflare-r2-secret-key"
R2_BUCKET="motolink-proofs"

# Notifications Multicanales (WhatsApp Business Meta + Fallback SMS Twilio/Local)
NOTIF_CHANNEL_DEFAULT="whatsapp"
WHATSAPP_PROVIDER="mock"
WHATSAPP_API_TOKEN="your-meta-whatsapp-api-token"
WHATSAPP_PHONE_NUMBER_ID="your-meta-whatsapp-phone-number-id"
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+237600000000"
SMS_PROVIDER="mock"
SMS_MOCK="true"

# Jev (TypeSafe AI) — Classification indicative du colis (Choice uniquement)
JEV_API_KEY="your-typesafe-jev-api-key"
JEV_API_URL="https://api.typesafe.ai"
JEV_ENABLED="true"
JEV_TIMEOUT_MS="2000"
JEV_CONFIDENCE_THRESHOLD="0.85"

# Horodatage certifié RFC 3161 (Time Stamp Authority)
TSA_URL="https://freetsa.org/tsr"




