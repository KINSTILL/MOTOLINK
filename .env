# Base de données PostgreSQL (Prisma ORM)
DATABASE_URL="postgresql://postgres:admin123@localhost:5432/motolink?schema=public"

# NextAuth.js
NEXTAUTH_SECRET="dev-secret-change-in-production-1234567890"
NEXTAUTH_URL="http://localhost:3000"

# NotchPay (Paiements Cameroun / FCFA : Orange Money, MTN MoMo)
NOTCHPAY_PUBLIC_KEY="pk.test.sample"
NOTCHPAY_SECRET_KEY="sk.test.sample"
NOTCHPAY_WEBHOOK_SECRET="whsec_test_sample"

# Firebase Cloud Messaging (Notifications Push PWA)
FCM_SERVER_KEY="fcm-server-key-placeholder"

# Cloudflare R2 (Stockage photos & signatures sécurisées)
R2_ACCESS_KEY="r2-access-key-placeholder"
R2_SECRET_KEY="r2-secret-key-placeholder"
R2_BUCKET="motolink-proofs"

# Notifications Multicanales (WhatsApp Business Meta + Fallback SMS Twilio/Local)
NOTIF_CHANNEL_DEFAULT="whatsapp"
WHATSAPP_PROVIDER="mock"
WHATSAPP_API_TOKEN="whatsapp-meta-api-token-placeholder"
WHATSAPP_PHONE_NUMBER_ID="whatsapp-phone-number-id-placeholder"
TWILIO_ACCOUNT_SID="AC00000000000000000000000000000000"
TWILIO_AUTH_TOKEN="twilio-auth-token-placeholder"
TWILIO_PHONE_NUMBER="+237600000000"
SMS_PROVIDER="mock"
SMS_MOCK="true"

# Jev (TypeSafe AI) — Classification indicative du colis (Choice uniquement)
JEV_API_KEY="jev-mock-api-key"
JEV_API_URL="https://api.typesafe.ai"
JEV_ENABLED="true"
JEV_TIMEOUT_MS="2000"
JEV_CONFIDENCE_THRESHOLD="0.85"

# Horodatage certifié RFC 3161 (Time Stamp Authority)
TSA_URL="https://freetsa.org/tsr"




